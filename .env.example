# Installation creates .env. Paths resolve relative to the project root.
KTV_PORT=8768
KTV_PROJECTS=ktv_projects
# Inference requires NVIDIA CUDA. CPU threads below are for host-side work.
KTV_CPU_THREADS=8
TIFA_SOURCE=models/forced_alignment/sources/TIFA
TIFA_MODEL=models/forced_alignment/tifa/TIFA-1.0-ST/model.pt
TIFA_PYTHON=.runtime/tifa/Scripts/python.exe
TIFA_G2P=
KTV_LOCATOR_PYTHON=.runtime/locator/Scripts/python.exe
KTV_ASR_MODEL=models/Qwen3-ASR-1.7B
KTV_SEPARATION_PYTHON=.runtime/separation/Scripts/python.exe
KTV_KIM_SOURCE=models/separation/sources/Kim
KTV_KIM_MODEL=models/separation/Kim/MelBandRoformer.ckpt
# Model package includes these; source users can install FFmpeg at these paths.
KTV_FFMPEG=tools/ffmpeg/bin/ffmpeg.exe
KTV_FFPROBE=tools/ffmpeg/bin/ffprobe.exe
KTV_LYRICS_API=https://lrclib.net/api
